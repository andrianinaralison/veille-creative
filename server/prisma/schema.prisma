generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Section {
  id          String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  title       String
  slug        String      @unique
  description String      @default("")
  position    Int         @default(0)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  references  Reference[]

  @@index([position])
}

model Reference {
  id                  String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  url                 String            @unique
  platform            Platform
  sourceMode          SourceMode        @default(MANUAL)
  title               String
  description         String            @default("")
  channelName         String            @default("")
  channelUrl          String            @default("")
  thumbnailUrl        String            @default("")
  thumbnailSourceUrl  String?
  thumbnailStorageKey String?
  channelAvatarUrl    String            @default("")
  tags                String[]          @default([]) // tags YouTube bruts — traçabilité uniquement, jamais exposés comme filtres
  taxonomy            String[]          @default([]) // slugs taxonomie 180° (enrichissement Claude + qualification admin)
  mood                String?
  typeContenu         String?
  context             String            @default("")
  status              RefStatus         @default(DRAFT)
  sectionId           String?
  ingestionSessionId  String?
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  publishedAt         DateTime?         @db.Timestamptz(6)
  videoPublishedAt    DateTime?         @db.Timestamptz(6)
  section             Section?          @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  ingestionSession    IngestionSession? @relation(fields: [ingestionSessionId], references: [id], onUpdate: NoAction)
  digestItems         DigestItem[]
  projectItems        ProjectItem[]

  @@index([status])
  @@index([platform])
  @@index([sectionId])
  @@index([createdAt(sort: Desc)])
  @@index([ingestionSessionId])
}

model IngestionSession {
  id          String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  mode        SourceMode
  status      SessionStatus @default(RUNNING)
  brief       String        @default("")
  totalFound              Int           @default(0)
  totalFiltered           Int           @default(0)
  totalSaved              Int           @default(0)
  totalFilteredByDuration Int           @default(0)
  totalFilteredByRules    Int           @default(0)
  totalAlreadyPublished   Int           @default(0)
  totalConflicts          Int           @default(0)
  conflicts               Json          @default("[]")
  errorMessage            String?
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  completedAt DateTime?     @db.Timestamptz(6)
  references  Reference[]
}

model Digest {
  id          String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  weekOf      DateTime     @unique @db.Date // lundi de la semaine couverte
  title       String
  intro       String       @default("")
  status      DigestStatus @default(DRAFT)
  publishedAt DateTime?    @db.Timestamptz(6)
  emailSentAt DateTime?    @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  items       DigestItem[]

  @@index([status, weekOf(sort: Desc)])
}

model DigestItem {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  digestId    String
  referenceId String
  position    Int       @default(0)
  note        String    @default("") // commentaire éditorial sur cette référence
  digest      Digest    @relation(fields: [digestId], references: [id], onDelete: Cascade)
  reference   Reference @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@unique([digestId, referenceId])
  @@index([digestId, position])
}

model User {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  email        String    @unique
  passwordHash String
  firstName    String    @default("")
  digestOptIn  Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  projects     Project[]
}

model Project {
  id         String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId     String
  title      String
  client     String        @default("")
  brief      String        @default("") // le brief reçu du client
  intention  String        @default("") // le parti pris créatif rédigé (cœur du treatment)
  status     ProjectStatus @default(DRAFT)
  deadline   DateTime?     @db.Timestamptz(6)
  shareToken String?       @unique // lien public révocable /t/:token
  createdAt  DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      ProjectItem[]

  @@index([userId, updatedAt(sort: Desc)])
}

model ProjectItem {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  projectId   String
  referenceId String
  position    Int       @default(0)
  note        String    @default("") // ce qu'on retient de cette réf pour CE projet
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reference   Reference @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@unique([projectId, referenceId])
  @@index([projectId, position])
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  DONE
}

model Creator {
  id              String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  name            String
  url             String?      @unique
  youtubeHandle   String?
  platform        Platform     @default(YOUTUBE)
  channelId       String?
  instagramHandle String?
  vimeoUrl        String?
  websiteUrl      String?
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  filterRules     FilterRule[]

  // Partial index on active creators: creator_active_name_idx — managed via 20260604_partial_indexes migration
}

model FilterRule {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  creatorId String
  type      String   // 'keyword_title' | 'channel_name'
  pattern   String   // mot-clé ou fragment, insensible à la casse
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([active])
}

enum Platform {
  YOUTUBE
  VIMEO
  WEB
}

enum SourceMode {
  TOPIC_DISCOVERY
  CREATOR_SCAN
  MANUAL
}

enum RefStatus {
  TRIAGE
  DRAFT
  PUBLISHED
  REJECTED
}

enum SessionStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum DigestStatus {
  DRAFT
  PUBLISHED
}
